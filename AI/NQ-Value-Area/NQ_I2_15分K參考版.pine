//@version=5
// NQ I2 15分K參考版（M15-C）：只供參考比較，不是凍結規則，不用於正式驗收。研究用，不是投資建議。
// 規則：前日 15 分K 價值區（5 點一格、70%）；09:30 開盤 > VAH 只找空、< VAL 只找多；
//       1 根 15 分K 收在區內 → 下一根 15 分K 開盤進場；10:00 進場取消當天；最晚 11:30；+55／−145；12:29 收盤出場。
// 回測（2024-01～2026-10，用 1 分K 判斷出場）：149 筆、勝率 61.1%、每筆 +$97；比 1 分K 版（+$171）差。
// 使用方式：NQ 單一合約（例如 NQZ2026）15 分K。圖上只有 15 分K，所以同一根同時碰到止盈止損時一律算止損。
indicator("NQ I2 15分K參考版", shorttitle="I2 15m", overlay=true, max_labels_count=300)

TZ      = "America/New_York"
BIN     = 5.0
VA_FRAC = 0.70
TP1     = 55.0
SL      = 145.0
LAST_V1 = 120

showTable = input.bool(true, "顯示資訊表")
viewOn    = input.bool(false, "查看過去某一天", group="歷史")
viewT     = input.time(timestamp("2026-10-21T00:00:00"), "日期", group="歷史")

mod   = hour(time, TZ) * 60 + minute(time, TZ)
ymd   = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
isRth = mod >= 570 and mod <= 959
idx   = mod - 570
viewYmd = year(viewT, "Asia/Taipei") * 10000 + month(viewT, "Asia/Taipei") * 100 + dayofmonth(viewT, "Asia/Taipei")

var map<int, float> prof = map.new<int, float>()
var int   profDate = na
var float sesHi = na
var float sesLo = na
var float pVAL = na
var float pVAH = na
var float pPOC = na
var float pdh  = na
var float pdl  = na
var string status = "等待開盤"

finalize = not na(profDate) and (not isRth or ymd != profDate) and map.size(prof) > 0
if finalize
    keys = map.keys(prof)
    array.sort(keys, order.ascending)
    kMin = array.get(keys, 0)
    kMax = array.get(keys, array.size(keys) - 1)
    total = 0.0
    poc = kMin
    pocV = -1.0
    for i = 0 to array.size(keys) - 1
        k = array.get(keys, i)
        v = map.get(prof, k)
        total += v
        if v > pocV
            pocV := v
            poc := k
    lo = poc
    hi = poc
    acc = pocV
    while acc < VA_FRAC * total and (lo > kMin or hi < kMax)
        lv = map.contains(prof, lo - 1) ? map.get(prof, lo - 1) : -1.0
        hv = map.contains(prof, hi + 1) ? map.get(prof, hi + 1) : -1.0
        if hv > lv
            hi += 1
            acc += math.max(0.0, hv)
        else
            lo -= 1
            acc += math.max(0.0, lv)
    pPOC := poc * BIN
    pVAL := lo * BIN
    pVAH := (hi + 1) * BIN
    pdh  := sesHi
    pdl  := sesLo
    map.clear(prof)
    profDate := na
    status := "等待下一個交易日開盤"

if isRth and barstate.isconfirmed
    if na(profDate)
        profDate := ymd
        sesHi := high
        sesLo := low
    else
        sesHi := math.max(sesHi, high)
        sesLo := math.min(sesLo, low)
    a = int(math.floor(low / BIN))
    b = int(math.floor(high / BIN))
    n = b - a + 1
    for k = a to b
        map.put(prof, k, (map.contains(prof, k) ? map.get(prof, k) : 0.0) + volume / n)

var int    dir     = 0
var bool   done    = false
var int    sigIdx  = na
var int    st      = 0        // 0 無、1 等進場、2 持倉中、3 已結束
var float  ePx     = na
var float  tp1Px   = na
var float  slPx    = na
var string res1    = "—"
var float  open930 = na

fmt(x) => str.tostring(x, "#,##0.00")

if mod == 570
    dir := 0
    done := false
    sigIdx := na
    st := 0
    ePx := na
    tp1Px := na
    slPx := na
    res1 := "—"
    open930 := open
    if na(pVAL)
        status := "沒有前一日價值區：今天不做"
    else
        dir := open > pVAH ? -1 : open < pVAL ? 1 : 0
        status := dir == -1 ? "開盤在 VAH 之上 → 只找空" : dir == 1 ? "開盤在 VAL 之下 → 只找多" : "開盤在價值區內 → 今天不做"
    label.new(bar_index, dir == -1 ? high : low, dir == 1 ? "15m 只找多 ▲" : dir == -1 ? "15m 只找空 ▼" : "15m 今天不做",
              color=dir == 1 ? color.new(color.green, 0) : dir == -1 ? color.new(color.red, 0) : color.new(color.gray, 0),
              textcolor=color.white, style=dir == -1 ? label.style_label_down : label.style_label_up, size=size.normal)
    alert("NQ I2 15m 參考版｜09:30 開盤 " + fmt(open) + "｜VAL " + fmt(pVAL) + "／VAH " + fmt(pVAH) + "｜" + status, alert.freq_once_per_bar)

preDir  = na(pVAL) ? 0 : close > pVAH ? -1 : close < pVAL ? 1 : 0
showDir = isRth ? dir : preDir

// 每根 15 分K 收盤（09:44、09:59 … 11:29 收）檢查：1 根收在區內 → 下一根開盤進場
if isRth and barstate.isconfirmed and dir != 0 and not done and idx >= 0 and idx <= 105 and idx % 15 == 0
    if close >= pVAL and close <= pVAH
        done := true
        ei = idx + 15
        if (ei >= 28 and ei <= 32) or ei > LAST_V1
            status := "訊號在 10:00 進場（禁止時段）→ 今天取消"
            alert("NQ I2 15m 參考版：訊號落在禁止時段，今天取消", alert.freq_once_per_bar_close)
        else
            sigIdx := idx
            st := 1
            status := (dir == 1 ? "做多" : "做空") + "訊號成立 → 下一根 15 分K 開盤進場"
            alert("NQ I2 15m 參考版 訊號：" + (dir == 1 ? "做多" : "做空") + "，下一根 15 分K 開盤進場｜止損 145、止盈 55", alert.freq_once_per_bar_close)

if st == 1 and isRth and idx == sigIdx + 15
    ePx   := open
    tp1Px := open + dir * TP1
    slPx  := open - dir * SL
    st    := 2
    status := "已進場" + (dir == 1 ? "多" : "空") + "，持倉中"
    alert("NQ I2 15m 參考版 進場 " + (dir == 1 ? "多 " : "空 ") + fmt(ePx) + "｜止損 " + fmt(slPx) + "｜止盈 " + fmt(tp1Px), alert.freq_once_per_bar)
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "15m 多 " : "15m 空 ") + fmt(ePx), color=dir == 1 ? color.new(color.green, 0) : color.new(color.red, 0),
              textcolor=color.white, style=dir == 1 ? label.style_label_up : label.style_label_down, size=size.small)

if isRth and barstate.isconfirmed and st == 2 and idx >= sigIdx + 15
    if dir == 1 ? low <= slPx : high >= slPx
        st := 3
        res1 := "止損"
    else if dir == 1 ? high >= tp1Px : low <= tp1Px
        st := 3
        res1 := "止盈"
    else if idx == 165
        st := 3
        res1 := "時間到 " + fmt(close)
    if st == 3
        status := "今天的交易已結束：" + res1
        alert("NQ I2 15m 參考版 結果：" + res1, alert.freq_once_per_bar_close)

// ---------- 查看過去某一天：在那天 16:00 前的最後一根K棒存下狀態 ----------
var float  vVAL = na
var float  vVAH = na
var float  vPOC = na
var float  vPdh = na
var float  vPdl = na
var int    vDir = 0
var float  vOpen = na
var string vStatus = "（這一天沒有資料，請確認日期是交易日，並把圖表往回捲到那一天）"
var float  vE = na
var float  vSl = na
var float  vTp = na
var string vRes = "—"
if viewOn and ymd == viewYmd and mod <= 959
    vVAL := pVAL
    vVAH := pVAH
    vPOC := pPOC
    vPdh := pdh
    vPdl := pdl
    vDir := isRth ? dir : 0
    vOpen := open930
    vStatus := status
    vE := ePx
    vSl := slPx
    vTp := tp1Px
    vRes := res1

// ---------- 畫圖 ----------
brk = finalize
pH = plot(brk ? na : pVAH, "VAH", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)
pL = plot(brk ? na : pVAL, "VAL", color=color.new(color.teal, 0), linewidth=2, style=plot.style_linebr)
fill(pH, pL, color=showDir == 1 ? color.new(color.green, 85) : showDir == -1 ? color.new(color.red, 85) : color.new(color.gray, 90), title="價值區底色")
plot(brk ? na : pPOC, "POC", color=color.new(color.gray, 30), linewidth=1, style=plot.style_linebr)
plot(brk ? na : pdh, "前一日盤中高", color=color.new(color.red, 40), linewidth=1, style=plot.style_circles)
plot(brk ? na : pdl, "前一日盤中低", color=color.new(color.green, 40), linewidth=1, style=plot.style_circles)
showLv = isRth and idx <= 165 and st >= 2
plot(showLv ? ePx : na, "進場價", color=color.new(color.blue, 0), style=plot.style_linebr, display=display.pane)
plot(showLv ? slPx : na, "止損", color=color.new(color.red, 0), style=plot.style_linebr, display=display.pane)
plot(showLv ? tp1Px : na, "止盈", color=color.new(color.green, 0), style=plot.style_linebr, display=display.pane)
bgcolor(isRth and idx == 30 ? color.new(color.gray, 85) : na, title="10:00 這根不進場")

var table t = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 20), border_width=1)
if showTable and barstate.islast
    hist = viewOn
    dDir = hist ? vDir : showDir
    dirTxt = hist ? ("（" + str.tostring(viewYmd) + "）" + (vDir == 1 ? "只找多 ▲" : vDir == -1 ? "只找空 ▼" : "不做")) :
             isRth ? (dir == 1 ? "今天只找多 ▲" : dir == -1 ? "今天只找空 ▼" : "今天不做") :
             (preDir == 1 ? "盤前預判：偏多 ▲" : preDir == -1 ? "盤前預判：偏空 ▼" : "盤前預判：在區內（可能不做）")
    table.cell(t, 0, 0, "I2 15分K參考版", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, timeframe.period == "15" ? "15分K ✓" : "請改用 15 分K！", text_color=timeframe.period == "15" ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 1, "方向", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, dirTxt, text_color=color.white, bgcolor=dDir == 1 ? color.new(color.green, 0) : dDir == -1 ? color.new(color.red, 0) : color.new(color.gray, 0), text_size=size.small)
    table.cell(t, 0, 2, "VAH／POC／VAL", text_color=color.orange, text_size=size.small)
    table.cell(t, 1, 2, fmt(hist ? vVAH : pVAH) + "／" + fmt(hist ? vPOC : pPOC) + "／" + fmt(hist ? vVAL : pVAL), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "前日高／低", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, fmt(hist ? vPdh : pdh) + "／" + fmt(hist ? vPdl : pdl), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "開盤", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, fmt(hist ? vOpen : open930), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 5, "狀態", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, hist ? vStatus : status, text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 6, "進場／止損／止盈", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 6, na(hist ? vE : ePx) ? "—" : fmt(hist ? vE : ePx) + "／" + fmt(hist ? vSl : slPx) + "／" + fmt(hist ? vTp : tp1Px), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 7, hist ? "那天結果" : "最近結果", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 7, hist ? vRes : res1, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 8, "回測（參考）", text_color=color.aqua, text_size=size.small)
    table.cell(t, 1, 8, "149 筆｜勝率 61.1%｜每筆 +$97｜2024 −$51、2025 +$306、2026 +$39", text_color=color.white, text_size=size.small)
    table.cell(t, 0, 9, "對照", text_color=color.aqua, text_size=size.small)
    table.cell(t, 1, 9, "1 分K 版 I2 v1：162 筆｜勝率 61.1%｜每筆 +$171（正式驗收用 1 分K 版）", text_color=color.white, text_size=size.small)
